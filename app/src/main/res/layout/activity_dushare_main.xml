<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dushareMainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dushare_surface">

    <!-- TOP NAVBAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/dushare_surface_lowest"
        android:elevation="3dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand Logo Icon Container -->
        <FrameLayout
            android:id="@+id/frameTopLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dushare_card"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />
        </FrameLayout>

        <!-- Brand Name & Screen Title -->
        <TextView
            android:id="@+id/txtTopNavBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/plusjakartasans_bold"
            android:letterSpacing="0.06"
            android:text="EDUSHARE"
            android:textColor="@color/dushare_primary_container"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/frameTopLogo"
            app:layout_constraintTop_toTopOf="@+id/frameTopLogo" />

        <TextView
            android:id="@+id/txtTopNavTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/plusjakartasans_bold"
            android:singleLine="true"
            android:text="Home"
            android:textColor="@color/dushare_on_surface"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/frameTopLogo"
            app:layout_constraintEnd_toStartOf="@+id/btnTopNavNotifications"
            app:layout_constraintStart_toEndOf="@+id/frameTopLogo"
            app:layout_constraintTop_toBottomOf="@+id/txtTopNavBrand" />

        <!-- Right Action: Notifications -->
        <ImageButton
            android:id="@+id/btnTopNavNotifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifikasi"
            android:src="@drawable/ic_dushare_notifications"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imgTopNavAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/dushare_on_surface_variant" />

        <!-- Right Action: Avatar -->
        <ImageView
            android:id="@+id/imgTopNavAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_dushare_pill_inactive"
            android:contentDescription="Profil"
            android:padding="2dp"
            android:src="@drawable/user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Nav Hairline Divider -->
    <View
        android:id="@+id/topNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dushare_card_stroke"
        app:layout_constraintTop_toBottomOf="@+id/topNavBar" />

    <!-- FRAGMENT CONTAINER -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topNavDivider" />

    <!-- Guideline for Bottom Bar top boundary -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomBarGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="64dp" />

    <!-- BOTTOM NAVBAR BACKGROUND & ITEMS -->
    <LinearLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/dushare_surface_lowest"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Beranda / Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTabHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dushare_home"
                app:tint="@color/dushare_primary_container" />

            <TextView
                android:id="@+id/labelTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plusjakartasans_bold"
                android:text="Beranda"
                android:textColor="@color/dushare_primary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Eksplor / Explore -->
        <LinearLayout
            android:id="@+id/tabExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTabExplore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dushare_explore"
                app:tint="@color/dushare_text_muted" />

            <TextView
                android:id="@+id/labelTabExplore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:text="Eksplor"
                android:textColor="@color/dushare_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Space for center floating add button -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- 4. Tersimpan / Saved -->
        <LinearLayout
            android:id="@+id/tabSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTabSaved"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dushare_saved"
                app:tint="@color/dushare_text_muted" />

            <TextView
                android:id="@+id/labelTabSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:text="Tersimpan"
                android:textColor="@color/dushare_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 5. Profil / Profile -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTabProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dushare_profile"
                app:tint="@color/dushare_text_muted" />

            <TextView
                android:id="@+id/labelTabProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:text="Profil"
                android:textColor="@color/dushare_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Top Hairline Divider for Bottom Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dushare_card_stroke"
        android:elevation="9dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarLayout" />

    <!-- 3. RAISED FLOATING CENTER '+' BUTTON (Matching Stitch Elevated FAB) -->
    <FrameLayout
        android:id="@+id/fabAddMaterial"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_dushare_fab"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dushare_add"
            app:tint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
