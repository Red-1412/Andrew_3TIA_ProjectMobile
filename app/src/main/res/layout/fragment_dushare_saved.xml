<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dushare_surface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Info Bar -->
        <TextView
            android:id="@+id/txtInfoSavedDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/plusjakartasans_regular"
            android:text="Materi yang kamu simpan untuk dipelajari kembali."
            android:textColor="@color/dushare_text_muted"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtSavedCountBadge"
            app:layout_constraintEnd_toStartOf="@+id/txtSavedCountBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtSavedCountBadge" />

        <!-- Counter Pill -->
        <TextView
            android:id="@+id/txtSavedCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dushare_pill_active"
            android:fontFamily="@font/plusjakartasans_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="8 Berkas"
            android:textColor="@color/dushare_primary_container"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Search Saved Input -->
        <LinearLayout
            android:id="@+id/layoutSavedSearchInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dushare_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSavedCountBadge">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dushare_search"
                app:tint="@color/dushare_outline" />

            <EditText
                android:id="@+id/edtSavedSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/plusjakartasans_regular"
                android:hint="Cari di materi tersimpan..."
                android:inputType="text"
                android:textColor="@color/dushare_on_surface"
                android:textColorHint="@color/dushare_outline"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Category Tabs -->
        <HorizontalScrollView
            android:id="@+id/scrollSavedTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutSavedSearchInput">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabSavedAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dushare_pill_active"
                    android:fontFamily="@font/plusjakartasans_bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Semua (8)"
                    android:textColor="@color/dushare_primary_container"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSavedRangkuman"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dushare_pill_inactive"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Rangkuman (4)"
                    android:textColor="@color/dushare_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSavedLatihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dushare_pill_inactive"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Latihan Soal (2)"
                    android:textColor="@color/dushare_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabSavedModul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dushare_pill_inactive"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Modul Kuliah (2)"
                    android:textColor="@color/dushare_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Saved List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollSavedTabs"
            tools:listitem="@layout/item_dushare_saved" />

        <!-- Tip Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardSavedTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dushare_card_tinted"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvSavedNotes">

            <TextView
                android:id="@+id/txtTipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plusjakartasans_bold"
                android:text="Simpan Catatan Favoritmu"
                android:textColor="@color/dushare_on_surface"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtTipDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plusjakartasans_regular"
                android:text="Tandai catatan atau rangkuman saat menjelajah agar cepat dibuka saat revisi ujian!"
                android:textColor="@color/dushare_text_muted"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtTipTitle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExploreNotes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dushare_primary_btn"
                android:fontFamily="@font/plusjakartasans_bold"
                android:paddingHorizontal="14dp"
                android:text="Jelajahi Materi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtTipDesc" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
